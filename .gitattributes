# Golden files are compared byte for byte, so their line endings must never be
# converted on checkout.
**/testdata/** -text

# Files installed on servers or run by sh keep LF line endings, whatever the
# platform they are checked out on.
packaging/** text eol=lf
*.sh text eol=lf

# Read line by line by tools/isolex/fetch.sh, which a carriage return on
# each line would break.
internal/isolex/wasm.lock text eol=lf
